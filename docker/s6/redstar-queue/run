#!/command/with-contenv sh
# redstar queue worker (verification mail, future PDF jobs). Supervised + restarted by s6.
# Disable with REDSTAR_RUN_WORKERS=false (e.g. if you run a separate worker container).
if [ "${REDSTAR_RUN_WORKERS:-true}" != "true" ]; then exec sleep infinity; fi
sleep "${REDSTAR_WORKER_START_DELAY:-20}"   # let the boot hook finish migrations
cd /var/www/html
exec php artisan queue:work --sleep=3 --tries=3 --timeout=300 --max-time=3600
