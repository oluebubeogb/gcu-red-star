APP_NAME="The Red Star"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://redstar.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

# PostgreSQL (separate Coolify resource)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=redstar
DB_USERNAME=redstar
DB_PASSWORD=

# Redis (separate Coolify resource)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
SESSION_DRIVER=redis
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Access
# Comma-separated usernames OR emails that are always admins.
ADMIN_USERNAMES=
# Optional first admin (seeded on boot, idempotent, pre-verified)
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME="Red Star Admin"
SEED_ADMIN_PASSWORD=

# Magazine storage — "magazines" = VPS disk (storage/app/magazines).
# Later: MAGAZINE_DISK=magazines_s3 + AWS_* below (R2/B2/MinIO/S3).
MAGAZINE_DISK=magazines
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mail — MAIL_* or Paddy-style SMTP_* (either works). Encryption follows the port:
# 587 = STARTTLS, 465 = TLS. Leave MAIL_SCHEME blank. Mail host must be DNS-only
# (grey cloud) on Cloudflare — proxied hosts time out on 587/465.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="The Red Star"
MAIL_PREFER_IPV4=true
MAIL_TIMEOUT=30
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# EMAIL_FROM=

# Container
REDSTAR_RUN_WORKERS=true
