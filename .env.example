APP_NAME="The Red Star"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://redstar.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

# PostgreSQL (separate Coolify resource)
# Prefer a single URL. DATABASE_URL (Coolify) is used first, then DB_URL, then discrete DB_*.
DB_CONNECTION=pgsql
DATABASE_URL=
# DB_URL=
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=redstar
# DB_USERNAME=redstar
# DB_PASSWORD=

# Redis (separate Coolify resource)
# Prefer REDIS_URL. Discrete REDIS_HOST / REDIS_PASSWORD / REDIS_PORT still work as a fallback.
REDIS_CLIENT=phpredis
REDIS_URL=
# REDIS_HOST=redis
# REDIS_PASSWORD=
# REDIS_PORT=6379
# REDIS_CACHE_DB=1
SESSION_DRIVER=redis
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Access
# Comma-separated usernames OR emails that are always admins.
ADMIN_USERNAMES=
# Optional first admin (seeded on boot, idempotent, pre-verified)
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME="Red Star Admin"
SEED_ADMIN_PASSWORD=

# Magazine storage — "magazines" = VPS disk (storage/app/magazines).
# Later: MAGAZINE_DISK=magazines_s3 + AWS_* below (R2/B2/MinIO/S3).
MAGAZINE_DISK=magazines
# Redis list the PDF worker listens on (REDIS_PREFIX is prepended). Blank = worker DB poll only.
REDSTAR_PDF_QUEUE=redstar:pdf
# Max edition PDF upload size in KB (keep <= PHP_UPLOAD_MAX_FILE_SIZE in the Dockerfile, 100M).
REDSTAR_MAX_PDF_KB=102400
# Allow HQ 'Seed demo data' in production (demo users get random passwords). Default false.
REDSTAR_ALLOW_DEMO=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mail — MAIL_* or Paddy-style SMTP_* (either works). Encryption follows the port:
# 587 = STARTTLS, 465 = TLS. Leave MAIL_SCHEME blank. Mail host must be DNS-only
# (grey cloud) on Cloudflare — proxied hosts time out on 587/465.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="The Red Star"
MAIL_PREFER_IPV4=true
MAIL_TIMEOUT=30
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# EMAIL_FROM=

# Container
REDSTAR_RUN_WORKERS=true

# ── Phase 5: AI via Replicate (all optional; without the token AI features are hidden) ──
REPLICATE_API_TOKEN=
REDSTAR_AI_ENABLED=true
REDSTAR_AI_SEARCH=true
REDSTAR_AI_ASK=true
REDSTAR_AI_SUMMARIES=true
REDSTAR_AI_OCR=true
REDSTAR_AI_AUDIO=true
REDSTAR_AI_ASSISTANT=true
REDSTAR_AI_AUTO_PUBLISH=false
REDSTAR_AI_LLM_MODEL=meta/meta-llama-3-8b-instruct
REDSTAR_AI_ASK_MODEL=meta/meta-llama-3-70b-instruct
REDSTAR_AI_EMBED_MODEL=ibm-granite/granite-embedding-278m-multilingual
REDSTAR_AI_TTS_MODEL=minimax/speech-02-turbo
REDSTAR_AI_TTS_VOICE=English_Deep-VoicedGentleman
REDSTAR_AI_PGVECTOR=true
REDSTAR_AI_EMBED_DIMS=768
REDSTAR_AI_DAILY_CAP=2000

# ── Phase 6: payments (NGN, amounts stored in kobo) ──
# paystack (default) or monnify. Only the selected gateway's keys need to be set.
PAYMENT_METHOD=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# PAYSTACK_BASE_URL=https://api.paystack.co
# Webhook (Paystack dashboard): https://<domain>/payments/webhook
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
# Sandbox default; live: https://api.monnify.com
# MONNIFY_BASE_URL=https://sandbox.monnify.com
# Webhook (Monnify dashboard → Developer → Transaction Completion): https://<domain>/payments/webhook/monnify
REDSTAR_FEATURED_MONTH_KOBO=500000
